ase.if","position":[-176,-128],"typeVersion":2},{"parameters":{},"id":"70ef7084-3233-483a-9888-33df312a585f","name":"Merge Items","type":"n8n-nodes-base.merge","position":[-176,144],"typeVersion":2},{"parameters":{"jsCode":"const orderJsonKeys = (jsonObj) => {\n  const ordered = {};\n  Object.keys(jsonObj).sort().forEach(key => {\n    ordered[key] = jsonObj[key];\n  });\n  return ordered;\n}\n\n// Check if file returned with content\nif (Object.keys($input.all()[0].json).includes(\"content\")) {\n  // Decode base64 content and parse JSON\n  const origWorkflow = JSON.parse(Buffer.from($input.all()[0].json.content, 'base64').toString());\n  const n8nWorkflow = $input.all()[1].json;\n  \n  // Order JSON objects\n  const orderedOriginal = orderJsonKeys(origWorkflow);\n  const orderedActual = orderJsonKeys(n8nWorkflow);\n\n  // Determine difference\n  if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n    $input.all()[0].json.github_status = \"same\";\n  } else {\n    $input.all()[0].json.github_status = \"different\";\n    $input.all()[0].json.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n  }\n  $input.all()[0].json.content_decoded = orderedOriginal;\n// No file returned / new workflow\n} else if (Object.keys($input.all()[0].json).includes(\"data\")) {\n  const origWorkflow = JSON.parse($input.all()[0].json.data);\n  const n8nWorkflow = $input.all()[1].json;\n  \n  // Order JSON objects\n  const orderedOriginal = orderJsonKeys(origWorkflow);\n  const orderedActual = orderJsonKeys(n8nWorkflow);\n\n  // Determine difference\n  if (JSON.stringify(orderedOriginal) === JSON.stringify(orderedActual)) {\n    $input.all()[0].json.github_status = \"same\";\n  } else {\n    $input.all()[0].json.github_status = \"different\";\n    $input.all()[0].json.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n  }\n  $input.all()[0].json.content_decoded = orderedOriginal;\n\n} else {\n  // Order JSON object\n  const n8nWorkflow = $input.all()[1].json;\n  const orderedActual = orderJsonKeys(n8nWorkflow);\n  \n  // Proper formatting\n  $input.all()[0].json.github_status = \"new\";\n  $input.all()[0].json.n8n_data_stringy = JSON.stringify(orderedActual, null, 2);\n}\n\n// Return items\nreturn $input.all();\n"},"id":"539472b4-c7b9-44c0-b0ef-41cf9d5a2aa2","name":"isDiffOrNew","type":"n8n-nodes-base.code","position":[16,144],"typeVersion":1},{"parameters":{"dataType":"string","value1":"={{$json.github_status}}","rules":{"rules":[{"value2":"same"},{"value2":"different","output":1},{"value2":"new","output":2}]}},"id":"adad5614-3ae8-4715-bf6f-a65b6a34c15d","name":"Check Status","type":"n8n-nodes-base.switch","position":[416,144],"typeVersion":1},{"parameters":{},"id":"39f89d7a-b0e2-46b9-a7cc-5f8c92cd15d5","name":"Same file - Do nothing","type":"n8n-nodes-base.noOp","position":[640,-16],"typeVersion":1},{"parameters":{},"id":"d17a0815-4936-409d-810a-7a7838043946","name":"File is different","type":"n8n-nodes-base.noOp","position":[640,144],"typeVersion":1},{"parameters":{},"id":"96843957-8c44-48e7-8fc4-a0d2e820debe","name":"File is new","type":"n8n-nodes-base.noOp","position":[640,336],"typeVersion":1},{"parameters":{"resource":"file","owner":{"__rl":true,"mode":"","value":"={{ $('Config').first().item.repo_owner }}"},"repository":{"__rl":true,"mode":"","value":"={{ $('Config').first().item.repo_name }}"},"filePath":"={{ $('Config').first().item.repo_path }}{{ $json.subPath }}{{$('Execute Workflow Trigger').first().json.id}}.json","fileContent":"={{$('isDiffOrNew').item.json[\"n8n_data_stringy\"]}}","commitMessage":"={{$('Execute Workflow Trigger').first().json.name}} ({{$json.github_status}})"},"id":"4aab8595-f352-4821-9e7c-7cdc192eef02","name":"Create new file","type":"n8n-nodes-base.github","position":[864,336],"typeVersion":1,"webhookId":"31a7787b-2873-4f77-b750-526a23a12e0f","credentials":{"githubApi":{"id":"p5ee36VZwjS4xEXx","name":"GitHub account"}}},{"parameters":{"resource":"file","operation":"edit","owner"